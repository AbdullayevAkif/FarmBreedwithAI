{
  "name": "farm-breed-ai-frontend",
  "version": "1.0.0",
  "description": "Frontend for Farm Breed with AI - Smart Animal Breeding Assistant",
  "main": "index.html",
  "scripts": {
    "start": "http-server -p 3000 -c-1 --cors",
    "dev": "http-server -p 3000 -c-1 --cors -o",
    "build": "echo 'Building frontend...' && npm run copy-assets",
    "copy-assets": "mkdir -p dist && cp -r *.html *.css *.js dist/",
    "serve": "http-server dist -p 3000 -c-1 --cors",
    "test": "echo 'No tests specified'",
    "lint": "echo 'No linting configured'"
  },
  "keywords": [
    "farm",
    "breeding",
    "ai",
    "animals",
    "agriculture",
    "frontend"
  ],
  "author": "Farm Tech Solutions",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}

